@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Form Submission";
}

<section class="hero">
    <h1 class="display-lg">Form Submission</h1>
    <p class="body-lg">Submit this form to send data to the server and get a response.</p>
</section>

<section class="card" style="max-width: 600px;">

    @if (ViewBag.Error != null)
    {
        <div style="background: #fee2e2; color: #7f1d1d; padding: 12px; border-radius: 6px; margin-bottom: 24px;">
            @ViewBag.Error
        </div>
    }

    @if (ViewBag.SuccessMessage != null)
    {
        <div style="background: #dcfce7; color: #14532d; padding: 12px; border-radius: 6px; margin-bottom: 24px;">
            @ViewBag.SuccessMessage
        </div>
    }

    <!-- The form POSTs to the same action -->
    @using (Html.BeginForm("Form", "Training", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-grid">
            <div class="field--full">
                <label class="form-label label-md" for="name">Full Name</label>
                <input type="text" id="name" name="name" class="form-input" required />
            </div>

            <div class="field--full">
                <label class="form-label label-md" for="email">Email</label>
                <input type="email" id="email" name="email" class="form-input" required />
            </div>
        </div>

        <div class="actions">
            <button type="submit" class="btn btn--primary">Submit Form</button>
        </div>
    }
</section>