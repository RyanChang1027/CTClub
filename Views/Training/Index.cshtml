
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Developer Training";
}

<section class="hero">
    <h1 class="display-lg">Developer Training</h1>
    <p class="body-lg">Welcome, Junior Developer! Explore how ASP.NET MVC works.</p>
</section>

<div class="dashboard-grid">

    <div class="card">
        <h2 class="headline-md">1. Passing Data</h2>
        <p class="body-md">Learn how the Controller sends data to the View using ViewBag and ViewData.</p>
        <a href="@Url.Action("Data", "Training")" class="btn btn--primary">Explore Data Passing</a>
    </div>

    <div class="card">
        <h2 class="headline-md">2. Form Submission</h2>
        <p class="body-md">Learn how to build a form, POST data to the server, and handle validation.</p>
        <a href="@Url.Action("Form", "Training")" class="btn btn--primary">Explore Forms</a>
    </div>

    <div class="card">
        <h2 class="headline-md">3. AJAX & APIs</h2>
        <p class="body-md">Learn how JavaScript talks to the server using AJAX and JSON without reloading the page.</p>
        <a href="@Url.Action("Api", "Training")" class="btn btn--primary">Explore AJAX</a>
    </div>
</div>