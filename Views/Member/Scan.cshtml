
@{ Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Scan Membership Card";

    var user = Session[CrownTowersClub.Infrastructure.Session.DevSessionKeys.User]
        as CrownTowersClub.Infrastructure.Session.DevSessionUser; }

<div id="scanner-config"
     data-url-lookup="@Url.Action("LookupByMembershipNumber", "Member")"
     hidden>
</div>

<section class="hero">
    <h1 class="display-lg">Scan Membership Card</h1>
    <p class="body-lg">
        Scan a member's QR code to view their membership details and status.
    </p>
</section>

<section class="card">
    <h2 class="headline-md section-title">QR Code Scanner</h2>

    <p class="body-md">
        Position the membership card's QR code inside the camera frame.
    </p>

    <div id="qr-reader" style="width: 100%; max-width: 500px; margin: 24px auto;"></div>

    <div id="scan-result" style="margin-top: 20px;">
        <p class="body-md">
            Your scan result will appear here.
        </p>
    </div>
</section>


@section scripts {
    @Scripts.Render("~/bundles/app-base")

    @*<script src="https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>*@
    <script src="@Url.Content("~/Scripts/vendor/html5-qrcode/html5-qrcode.min.js")"></script>
    <script src="@Url.Content("~/Scripts/app/membership-scanner.js")"></script>
}