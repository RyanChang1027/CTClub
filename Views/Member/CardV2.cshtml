@model CrownTowersClub.ViewModels.MembershipCardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Membership Card";

    // Generate the verification URL
    //var verificationUrl = Url.Action("Verify", "Member", new { id = Model.MembershipNumber }, Request.Url.Scheme);
    
}

<section class="hero">
    <h1 class="display-lg">My Membership Card</h1>
    <p class="body-lg">Official digital membership card for @Model.ValidYear.</p>
</section>

<div class="flex justify-center" style="margin-bottom: 32px;">

    <!-- The Premium Card -->
    <div class="membership-card-v2">

        <!-- Top Section: Logo & Status -->
        <div class="card-v2-top">
            <div class="logo-area">
                <img src="@Url.Content("~/Content/app/images/krctk-logo.png")" alt="Club Logo" class="card-logo" />
                <div class="club-name">CROWN TOWERS CLUB</div>
            </div>
            <div class="status-badge">ACTIVE MEMBER</div>
        </div>

        <!-- Middle Section: Name & QR Code -->
        <div class="card-v2-middle" style="display: flex; justify-content: space-between; align-items: center;">
            
            <!-- Left: Member Info -->
            <div class="member-info">
                <div class="member-name">@Model.Name</div>
                <div class="member-nric">NRIC: @Model.NRIC</div>
                <div class="member-dept">@Model.Department</div>
                <div class="member-company">@Model.CompanyName</div>
            </div>

            <!-- Right: QR Code -->
            <div class="qr-container">
                <div id="qrcode"></div>
            </div>
        </div>

        <!-- Bottom Section: Details -->
        <div class="card-v2-bottom">
            <div class="detail-group">
                <div class="label">MEMBER NO.</div>
                <div class="value">@Model.MembershipNumber</div>
            </div>
            <div class="detail-group">
                <div class="label">MEMBER SINCE</div>
                <div class="value">@(Model.AdmissionDate.HasValue ? Model.AdmissionDate.Value.ToString("MM/yyyy") : "N/A")</div>
            </div>
            <div class="detail-group">
                <div class="label">VALID UNTIL</div>
                <div class="value">31/12/@Model.ValidYear</div>
            </div>
        </div>
    </div>
</div>

<div class="flex justify-center gap-4">
    <button type="button" onclick="window.print();" class="btn btn--primary">
        <span class="material-symbols-outlined" style="margin-right: 8px;">print</span>
        Print Card
    </button>
    @*<a href="@Url.Action("Card", "Member")" class="btn btn--outline">Switch to Classic Design</a>*@
    <a href="@Url.Action("Mine", "Member")" class="btn btn--outline">Back to My Applications</a>
</div>

@section scripts {
    <!-- QR Code Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Generate the QR Code
            @*var qrData = "@verificationUrl";*@
            var qrData = "@Model.MembershipNumber";
            new QRCode(document.getElementById("qrcode"), {
                text: qrData,
                width: 256,
                height: 256,
                colorDark : "#000000",
                colorLight : "#ffffff",
                correctLevel : QRCode.CorrectLevel.H // High error correction
            });
        });
    </script>

    <style>
        /* ==========================================
           Premium Membership Card Design
           ========================================== */
        .membership-card-v2 {
            width: 100%;
            max-width: 480px;
            height: 300px;
            border-radius: 20px;
            /* Emerald Green & Gold Gradient */
            background: linear-gradient(145deg, #064e3b 0%, #022c22 100%);
            color: #ffffff;
            padding: 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 25px 30px -5px rgba(0, 0, 0, 0.4), 0 15px 15px -5px rgba(0, 0, 0, 0.2);
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

            /* Gold Accent Line */
            .membership-card-v2::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 6px;
                background: linear-gradient(90deg, #fbbf24 0%, #f59e0b 100%);
            }

            /* Decorative background circles */
            .membership-card-v2::after {
                content: '';
                position: absolute;
                bottom: -60px;
                right: -60px;
                width: 200px;
                height: 200px;
                border: 2px solid rgba(255, 255, 255, 0.05);
                border-radius: 50%;
            }

        .card-v2-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            z-index: 1;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .card-logo {
            height: 50px;
            width: auto;
            object-fit: contain;
        }

        .club-name {
            font-family: var(--font-display);
            font-size: 14px;
            letter-spacing: 2px;
            font-weight: 700;
            color: #fbbf24; /* Gold */
        }

        .status-badge {
            background: rgba(251, 191, 36, 0.15); /* Gold tint */
            color: #fbbf24;
            border: 1px solid rgba(251, 191, 36, 0.5);
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .card-v2-middle {
            z-index: 1;
            margin-top: 16px;
        }

        .member-name {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 4px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .member-nric, .member-dept, .member-company {
            font-size: 14px;
            color: #a7f3d0; /* Light emerald */
            font-family: monospace;
            letter-spacing: 1px;
        }

        .card-v2-bottom {
            display: flex;
            justify-content: space-between;
            z-index: 1;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 16px;
        }

        .detail-group .label {
            font-size: 9px;
            letter-spacing: 1px;
            color: #a7f3d0;
            margin-bottom: 4px;
            text-transform: uppercase;
        }

        .detail-group .value {
            font-size: 14px;
            font-weight: 700;
            color: #ffffff;
        }

        .detail-group:last-child .value {
            font-family: inherit;
        }

        /* ==========================================
           Print Settings
           ========================================== */
        @@media print {
            body * {
                visibility: hidden;
            }

            .membership-card-v2, .membership-card-v2 * {
                visibility: visible;
            }

            .membership-card-v2 {
                position: fixed;
                left: 50%;
                top: 50%;
                transform: translate(-50%, -50%);
                box-shadow: none;
                border: 1px solid #000;
                print-color-adjust: exact;
                -webkit-print-color-adjust: exact;
            }

            .app-bar,
            .main > .hero,
            .main > .flex.justify-center.gap-4,
            .footer {
                display: none !important;
            }
        }

        /* Add these new QR styles */
        .member-info {
            flex: 1;
            padding-right: 16px;
        }

        .qr-container {
            background: #ffffff;
            padding: 4px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        /* Ensure the QR code renders sharply */
        #qrcode img {
            display: block;
            width: 80px;
            height: 80px;
            border-radius: 4px;
        }

        /* In the print media query, make sure the QR code is visible */
        @@media print {
            .qr-container {
                box-shadow: none;
                border: 1px solid #ccc;
            }
        }
    </style>
}