@model CrownTowersClub.ViewModels.EventIndexViewModel

@{ Layout = "~/Views/Shared/_Layout.cshtml";
                ViewBag.Title = "Event Management"; }

<section class="hero events-hero">

    <div>
        <h1 class="display-lg">Event Management</h1>

        <p class="body-lg">
            Manage and organise Crown Towers Club events.
        </p>
    </div>

    <a href="@Url.Action("Create", "Events")"
       class="btn btn--primary">
        <span class="material-symbols-outlined">add</span>
        Create Event
    </a>

</section>

<section class="card events-card">

    <div class="events-toolbar">

        @using (Html.BeginForm("Index", "Events", FormMethod.Get,
            new { @class = "events-search" }))
        {
<span class="material-symbols-outlined">
    search
</span>

                <input type="search"
                       name="searchTerm"
                       class="form-input"
                       value="@Model.SearchTerm"
                       placeholder="Search by event name or location..." />}

    </div>

    <div class="table-scroll">

        <table class="queue-table events-table">

            <thead>
                <tr>
                    <th>Picture</th>
                    <th>Event Name</th>
                    <th>Venue / Location</th>
                    <th>Event Date</th>
                    <th>Time Schedule</th>
                    <th class="events-action-heading">Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Events != null && Model.Events.Count > 0)
                {
                    foreach (var eventItem in Model.Events)
                    {
    <tr>
        <td>
            @if (!string.IsNullOrWhiteSpace(eventItem.EventImagePath))
            {
<img src="@Url.Content(eventItem.EventImagePath)"
     alt="@eventItem.EventName"
     class="events-thumbnail" /> }
                    else
                    {
<div class="events-thumbnail events-thumbnail--placeholder">
    <span class="material-symbols-outlined">
        event
    </span>
</div>}
        </td>

        <td>
            <strong>@eventItem.EventName</strong>
        </td>

        <td>
            @(eventItem.VenueName ?? "Venue unavailable")
        </td>

        <td>
            @if (eventItem.StartDateTime.HasValue)
            {
                @eventItem.StartDateTime.Value.ToString("dd MMM yyyy")

                if (eventItem.EndDateTime.HasValue &&
                    eventItem.StartDateTime.Value.Date != eventItem.EndDateTime.Value.Date)
                {
                    <span>
                        – @eventItem.EndDateTime.Value.ToString("dd MMM yyyy")
                    </span>
                }
            }
            else if (eventItem.EndDateTime.HasValue)
            {
                <span>
                    Ends @eventItem.EndDateTime.Value.ToString("dd MMM yyyy")
                </span>
            }
            else
            {
                <span>Not scheduled</span>
            }
        </td>

        <td>
            @if (eventItem.StartDateTime.HasValue)
            {
                @eventItem.StartDateTime.Value.ToString("h:mm tt")
            }

            @if (eventItem.StartDateTime.HasValue &&
                 eventItem.EndDateTime.HasValue)
            {
                <span> – </span>
            }

            @if (eventItem.EndDateTime.HasValue)
            {
                @eventItem.EndDateTime.Value.ToString("h:mm tt")
            }

            @if (!eventItem.StartDateTime.HasValue &&
                 !eventItem.EndDateTime.HasValue)
            {
                <span>Not scheduled</span>
            }
        </td>

        <td class="events-action-heading">
            <button type="button"
                    class="btn btn--secondary"
                    disabled
                    title="Event details will be available in the next step">
                <span class="material-symbols-outlined">
                    visibility
                </span>
            </button>
        </td>
    </tr> }
                }
                else
                {
    <tr>
        <td colspan="6" class="events-empty-cell">

            <span class="material-symbols-outlined">
                event_busy
            </span>

            <strong>
                @(string.IsNullOrWhiteSpace(Model.SearchTerm)
                                    ? "No events to display yet."
                                    : "No matching events found.")
            </strong>

            <span>
                @(string.IsNullOrWhiteSpace(Model.SearchTerm)
                                    ? "Your club events will appear here once they have been added."
                                    : "Try searching with a different event name or location.")
            </span>

        </td>
    </tr>}

            </tbody>

        </table>

    </div>

</section>