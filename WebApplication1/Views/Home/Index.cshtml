@model CrownTowersClub.Models.Member
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Dashboard";

    var user = ViewBag.User as CrownTowersClub.Infrastructure.Session.DevSessionUser;
    var error = ViewBag.Error as string;
}

@if (user == null)
{
    <section class="home-landing">

        <!-- LEFT: CLUB BRANDING -->
        <div class="home-intro">

            <div class="home-brand">
                <div class="home-brand-mark">
                    <img src="@Url.Content("~/Content/app/images/krctk-logo.png")"
                         alt="Crown Towers Club Logo" />
                </div>

                <div>
                    <span class="home-brand-name">CROWN TOWERS CLUB</span>
                    <span class="home-brand-caption">Membership Management System</span>
                </div>
            </div>

            <div class="home-intro-content">
                <span class="home-eyebrow">WELCOME TO THE CLUB</span>

                <h1>
                    Your Club.
                    <br />
                    Your Community.
                </h1>

                <p>
                    Access your membership information and manage
                    club activities through the Crown Towers Club
                    membership portal.
                </p>
            </div>

            <div class="home-intro-footer">
                <span class="material-symbols-outlined">verified_user</span>
                <span>Official Crown Towers Club Portal</span>
            </div>

        </div>


        <!-- RIGHT: LOGIN CARD -->
        <section class="home-login-card">

            <div class="home-login-heading">
                <span class="home-login-icon material-symbols-outlined">
                    account_circle
                </span>

                <h2>Access Your Account</h2>

                <p>Enter your NRIC and select your role to continue.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <p class="error" role="alert">@error</p>
            }

            @using (Html.BeginForm("Begin", "DevSession", FormMethod.Post,
                new { id = "dev-login-form" }))
            {
                <div class="home-nric-field">
                    <label class="form-label label-md" for="nric">
                        NRIC NUMBER
                    </label>

                    <input id="nric"
                           name="pICNo"
                           class="form-input"
                           type="text"
                           maxlength="20"
                           value="900101-13-5001"
                           placeholder="000000-00-0000"
                           required />
                </div>

                <div class="home-role-heading">
                    <span>CONTINUE AS</span>
                </div>

                <div class="home-role-buttons">

                    <button type="submit"
                            name="role"
                            value="Staff"
                            class="home-role-button">
                        <span class="material-symbols-outlined">person</span>
                        <span>
                            <strong>Staff</strong>
                            <small>Access your membership</small>
                        </span>
                        <span class="material-symbols-outlined home-role-arrow">
                            arrow_forward
                        </span>
                    </button>

                    <button type="submit"
                            name="role"
                            value="DepartmentHead"
                            class="home-role-button">
                        <span class="material-symbols-outlined">supervisor_account</span>
                        <span>
                            <strong>Department Head</strong>
                            <small>Review membership applications</small>
                        </span>
                        <span class="material-symbols-outlined home-role-arrow">
                            arrow_forward
                        </span>
                    </button>

                    <button type="submit"
                            name="role"
                            value="Committee"
                            class="home-role-button">
                        <span class="material-symbols-outlined">groups</span>
                        <span>
                            <strong>Club Committee</strong>
                            <small>Manage club membership activities</small>
                        </span>
                        <span class="material-symbols-outlined home-role-arrow">
                            arrow_forward
                        </span>
                    </button>

                </div>
            }

        </section>

    </section>
}
else
{
    <!-- ============================================================
         STATE 2: LOGGED IN (The Dashboard)
         ============================================================ -->
    <section class="hero">
        <h1 class="display-lg">Welcome, @user.Name</h1>
        <p class="body-lg">
            You are logged in as <strong>@user.Role</strong> (@user.Department).
        </p>
    </section>

    <div class="dashboard-grid">

        <!-- ========================================================
             CARD 1: MY MEMBERSHIP STATUS
             ======================================================== -->
        <section class="card dashboard-card">
            <h2 class="headline-md section-title">My Membership</h2>

            @if (Model == null)
            {
                <!-- No Application -->
                <p class="body-md" style="color: var(--on-surface-variant); margin-bottom: 24px;">
                    You have not started a membership application yet.
                </p>
                <div class="dashboard-actions">
                    <a href="@Url.Action("Index", "Member")" class="btn btn--primary">
                        Apply Now
                    </a>
                </div>
            }
            else if (Model.MembershipStatus == "Active" && Model.CurrentTermStatus == "Active")
            {
                <!-- Active & Paid -->
                <div class="flex items-center gap-3" style="color: var(--success); margin-bottom: 16px;">
                    <span class="material-symbols-outlined" style="font-size: 32px;">verified</span>
                    <strong class="body-lg">Active Member</strong>
                </div>
                <p class="body-md">Membership No: <strong>@Model.MembershipNumber</strong></p>
                <div class="dashboard-actions">
                    <a href="@Url.Action("CardV2", "Member")" class="btn btn--primary">
                        Membership Card
                    </a>

                    <a href="@Url.Action("Mine", "Member")" class="btn btn--outline">
                        My Applications
                    </a>
                </div>
            }
            else if (Model.MembershipStatus == "Active" && Model.CurrentTermStatus == "Pending Payment")
            {
                <!-- Active but Renewal Pending -->
                <div class="flex items-center gap-3" style="color: var(--secondary); margin-bottom: 16px;">
                    <span class="material-symbols-outlined" style="font-size: 32px;">pending_actions</span>
                    <strong class="body-lg">Renewal Pending</strong>
                </div>
                <p class="body-md">Your membership is active, but your fee for @DateTime.Now.Year is outstanding. Please settle it to avoid suspension.</p>
                <div class="dashboard-actions">
                    <a href="@Url.Action("Mine", "Member")" class="btn btn--outline">
                        My Applications
                    </a>
                </div>
            }
            else if (Model.MembershipStatus == "Pending Activation")
            {
                <!-- Approved but Not Paid -->
                <div class="flex items-center gap-3" style="color: var(--secondary); margin-bottom: 16px;">
                    <span class="material-symbols-outlined" style="font-size: 32px;">pending_actions</span>
                    <strong class="body-lg">Pending Payment</strong>
                </div>
                <p class="body-md">Your application is approved! Please proceed to the Club office to pay your admission fee.</p>
                <div class="dashboard-actions">
                    <a href="@Url.Action("Mine", "Member")" class="btn btn--outline">
                        My Applications
                    </a>
                </div>
            }
            else if (Model.MembershipStatus == "Suspended")
            {
                <!-- Suspended -->
                <div class="flex items-center gap-3" style="color: var(--danger); margin-bottom: 16px;">
                    <span class="material-symbols-outlined" style="font-size: 32px;">block</span>
                    <strong class="body-lg">Membership Suspended</strong>
                </div>
                <p class="body-md">Your membership is temporarily inactive due to overdue payments. Please contact the Club Committee to reactivate.</p>
                <div class="dashboard-actions">
                    <a href="@Url.Action("Mine", "Member")" class="btn btn--outline">
                        My Applications
                    </a>
                </div>
            }
            else if (Model.MembershipStatus == "Cancelled")
            {
                <!-- Cancelled -->
                <div class="flex items-center gap-3" style="color: var(--danger); margin-bottom: 16px;">
                    <span class="material-symbols-outlined" style="font-size: 32px;">cancel</span>
                    <strong class="body-lg">Membership Cancelled</strong>
                </div>
                <p class="body-md">This membership has been permanently cancelled.</p>
                <div class="dashboard-actions">
                    <a href="@Url.Action("Mine", "Member")" class="btn btn--outline">
                        My Applications
                    </a>
                </div>
            }
            else if (Model.ApplicationStatus == "Returned for Correction")
            {
                <!-- Returned for Correction -->
                <div class="dashboard-status dashboard-status--returned">
                    <span class="material-symbols-outlined">edit_note</span>
                    <strong class="body-lg">@Model.ApplicationStatus</strong>
                </div>

                <p class="body-md">
                    Your application has been returned for correction.
                    Please review and update the required information.
                </p>

                <div class="dashboard-actions">
                    <a href="@Url.Action("Mine", "Member")" class="btn btn--outline">
                        My Applications
                    </a>
                </div>
            }
            else if (Model.ApplicationStatus == "Rejected by Dept Head" ||
                     Model.ApplicationStatus == "Rejected by Committee")
            {
                <!-- Rejected Application -->
                <div class="dashboard-status dashboard-status--rejected">
                    <span class="material-symbols-outlined">cancel</span>
                    <strong class="body-lg">@Model.ApplicationStatus</strong>
                </div>

                <p class="body-md">
                    Unfortunately, your membership application has been rejected.
                </p>

                <div class="dashboard-actions">
                    <a href="@Url.Action("Mine", "Member")" class="btn btn--outline">
                        My Applications
                    </a>
                </div>
            }
            else
            {
                <!-- Pending / Verified / Draft -->
                <div class="flex items-center gap-3" style="color: var(--info); margin-bottom: 16px;">
                    <span class="material-symbols-outlined" style="font-size: 32px;">hourglass_top</span>
                    <strong class="body-lg">@Model.ApplicationStatus</strong>
                </div>

                <p class="body-md">Your application is currently being processed.</p>

                <div class="dashboard-actions">
                    <a href="@Url.Action("Mine", "Member")" class="btn btn--outline">
                        My Applications
                    </a>
                </div>
            }
        </section>
        
        <!-- ========================================================
             CARD 2: ROLE-SPECIFIC TASKS (Admin Dashboard)
             ======================================================== -->
        @if (user.Role == CrownTowersClub.Infrastructure.Session.DevRoles.DepartmentHead ||
            user.Role == CrownTowersClub.Infrastructure.Session.DevRoles.Committee)
        {
            <section class="card dashboard-card">
                <h2 class="headline-md section-title">Action Center</h2>

                @if (user.Role == CrownTowersClub.Infrastructure.Session.DevRoles.DepartmentHead)
                {
                    var pendingCount = (int)(ViewBag.PendingReviewsCount ?? 0);
                    <div class="stat-row">
                        <div>
                            <span class="label-sm" style="color: var(--on-surface-variant);">Pending Reviews</span>
                            <div class="display-lg" style="font-size: 32px; margin-top: 8px;">@pendingCount</div>
                        </div>
                    </div>

                    <div class="dashboard-actions">
                        <a href="@Url.Action("Pending", "Review")"
                           class="btn btn--primary @(pendingCount == 0 ? "disabled" : "")"
                           style="@(pendingCount == 0 ? "pointer-events: none; opacity: 0.5;" : "")">
                            Review Now
                        </a>
                    </div>
                }

                else if (user.Role == CrownTowersClub.Infrastructure.Session.DevRoles.Committee)
                {
                    var verifiedCount = (int)(ViewBag.VerifiedCount ?? 0);
                    var paymentsCount = (int)(ViewBag.PaymentsCount ?? 0);

                    <div class="stat-row">
                        <div>
                            <span class="label-sm" style="color: var(--on-surface-variant);">Verified Applications</span>
                            <div class="display-lg" style="font-size: 32px; margin-top: 8px;">@verifiedCount</div>
                        </div>
                    </div>

                    <div class="dashboard-actions">
                        <a href="@Url.Action("Verified", "Review")"
                           class="btn btn--primary @(verifiedCount == 0 ? "disabled" : "")"
                           style="@(verifiedCount == 0 ? "pointer-events: none; opacity: 0.5;" : "")">
                            Review Now
                        </a>
                    </div>

                    <div class="stat-row" style="margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--outline-variant);">
                        <div>
                            <span class="label-sm" style="color: var(--on-surface-variant);">Pending Payments</span>
                            <div class="display-lg" style="font-size: 32px; margin-top: 8px;">@paymentsCount</div>
                        </div>
                    </div>
                    
                    <div class="dashboard-actions">
                        <a href="@Url.Action("PaymentDashboard", "Review")"
                           class="btn btn--outline @(paymentsCount == 0 ? "disabled" : "")"
                           style="@(paymentsCount == 0 ? "pointer-events: none; opacity: 0.5;" : "")">
                            Record Payments
                        </a>
                    </div>
                }
            </section>
        }
    </div>
}