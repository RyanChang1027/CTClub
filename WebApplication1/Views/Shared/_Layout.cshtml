<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - Crown Towers Club</title>

    @Styles.Render("~/bundles/vendor-css", "~/bundles/app-css")
</head>
<body>

    @{
        var devUser = Session[
            CrownTowersClub.Infrastructure.Session.DevSessionKeys.User
        ] as CrownTowersClub.Infrastructure.Session.DevSessionUser;
    }

    @if (devUser != null)
    {
    <div class="app-shell">

        <!-- MOBILE HEADER -->
        <header class="mobile-app-header">

            <a href="@Url.Action("Index", "Home")"
               class="mobile-app-brand">

                <img src="@Url.Content("~/Content/app/images/krctk-logo.png")"
                     alt="Crown Towers Club Logo" />

                <span>Crown Towers Club</span>

            </a>

            <button type="button"
                    class="mobile-nav-toggle"
                    id="mobile-nav-toggle"
                    aria-label="Open navigation menu"
                    aria-controls="app-sidebar"
                    aria-expanded="false">

                <span class="material-symbols-outlined">
                    menu
                </span>

            </button>

        </header>

        <!-- MOBILE SIDEBAR BACKDROP -->
        <button type="button"
                class="sidebar-backdrop"
                id="sidebar-backdrop"
                aria-label="Close navigation menu">
        </button>

        @Html.Partial("_Navigation", devUser)

        <main class="main app-main" aria-live="polite">
            @RenderBody()
        </main>

    </div>
    }
    else
    {
        <main class="main" aria-live="polite">
            @RenderBody()
        </main>
    }

    @Scripts.Render("~/bundles/vendor-js")
    @Scripts.Render("~/bundles/app-shell")
    @RenderSection("scripts", required: false)

</body>
</html>