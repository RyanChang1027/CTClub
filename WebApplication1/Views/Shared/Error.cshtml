@model System.Web.Mvc.HandleErrorInfo
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Error";
}

<div style="text-align: center; padding: 60px 20px;">
    <h1 class="display-lg" style="color: var(--danger); margin-bottom: 16px;">
        Oops! Something went wrong.
    </h1>

    <p class="body-lg" style="color: var(--on-surface-variant); max-width: 600px; margin: 0 auto 32px;">
        An unexpected error occurred while processing your request.
        Our team has been notified, but if the issue persists, please contact support.
    </p>

    @if (Model != null && HttpContext.Current.IsDebuggingEnabled)
    {
        <div style="text-align: left; background: #fee2e2; padding: 20px; border-radius: 8px; max-width: 800px; margin: 0 auto 32px; overflow-x: auto;">
            <strong>Debug Info (Only visible in Debug mode):</strong><br />
            <code>@Model.Exception.Message</code>
        </div>
    }

    <div class="actions" style="justify-content: center;">
        <a href="@Url.Action("Index", "Home")" class="btn btn--primary">
            Back to Home
        </a>
    </div>
</div>