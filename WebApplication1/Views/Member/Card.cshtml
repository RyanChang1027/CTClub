@model CrownTowersClub.ViewModels.MembershipCardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Membership Card";
}

<section class="hero">
    <h1 class="display-lg">My Membership Card</h1>
    <p class="body-lg">This is your official digital membership card for @Model.ValidYear.</p>
</section>

<div class="flex justify-center" style="margin-bottom: 32px;">

    <!-- The Card -->
    <div class="membership-card">
        <div class="card-header">
            <div class="logo-area">
                <!-- If you have a white logo version, use it here -->
                <span class="club-name">CROWN TOWERS CLUB</span>
            </div>
            <div class="status-badge">ACTIVE</div>
        </div>

        <div class="card-body">
            <div class="member-name">@Model.Name</div>
            <div class="member-nric">NRIC: @Model.NRIC</div>
            <div class="member-dept">@Model.Department</div>
            <div class="member-company">@Model.CompanyName</div>
        </div>

        <div class="card-footer">
            <div>
                <div class="label">MEMBER NO.</div>
                <div class="value">@Model.MembershipNumber</div>
            </div>
            <div>
                <div class="label">MEMBER SINCE</div>
                <div class="value">@(Model.AdmissionDate.HasValue ? Model.AdmissionDate.Value.ToString("MM/yyyy") : "N/A")</div>
            </div>
            <div>
                <div class="label">VALID UNTIL</div>
                <div class="value">31/12/@Model.ValidYear</div>
            </div>
        </div>
    </div>
</div>

<div class="flex justify-center gap-4">
    <button type="button" onclick="window.print();" class="btn btn--primary">
        <span class="material-symbols-outlined" style="margin-right: 8px;">print</span>
        Print Card
    </button>
    <a href="@Url.Action("Mine", "Member")" class="btn btn--outline">Back to My Applications</a>
</div>

@section scripts {
    <style>
        /* Membership Card Styling (Screen) */
        .membership-card {
            width: 100%;
            max-width: 450px;
            height: 280px;
            border-radius: 16px;
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            color: #ffffff;
            padding: 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

            .membership-card::before {
                content: '';
                position: absolute;
                top: -50px;
                right: -50px;
                width: 200px;
                height: 200px;
                background: radial-gradient(circle, rgba(119, 90, 25, 0.4) 0%, rgba(119, 90, 25, 0) 70%);
                border-radius: 50%;
            }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            z-index: 1;
        }

        .club-name {
            font-family: var(--font-display);
            font-size: 14px;
            letter-spacing: 2px;
            font-weight: 700;
            color: #fbbf24;
        }

        .status-badge {
            background: rgba(22, 163, 74, 0.2);
            color: #4ade80;
            border: 1px solid #16a34a;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .card-body {
            z-index: 1;
        }

        .member-name {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 4px;
            letter-spacing: 1px;
        }

        .member-nric, .member-dept, .member-company {
            font-size: 12px;
            color: #cbd5e1;
            margin-bottom: 2px;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            z-index: 1;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 16px;
        }

            .card-footer .label {
                font-size: 9px;
                letter-spacing: 1px;
                color: #94a3b8;
                margin-bottom: 4px;
            }

            .card-footer .value {
                font-size: 14px;
                font-weight: 700;
                font-family: 'Courier New', Courier, monospace;
            }

        /* =========================================
           PRINT SETTINGS (Centers the card)
           ========================================= */
        @@media print {
            /* Hide everything on the page */
            body * {
                visibility: hidden;
            }

            /* Show only the card and its contents */
            .membership-card, .membership-card * {
                visibility: visible;
            }

            /* Center the card perfectly on the A4 page */
            .membership-card {
                position: fixed;
                left: 50%;
                top: 50%;
                transform: translate(-50%, -50%);
                /* Remove web shadows and borders for clean printing */
                box-shadow: none;
                border: 1px solid #000;
                /* Ensure background colors and gradients print */
                print-color-adjust: exact;
                -webkit-print-color-adjust: exact;
            }

            /* Hide the page layout */
            .app-bar,
            .main > .hero,
            .main > .flex.justify-center.gap-4,
            .footer {
                display: none !important;
            }
        }
    </style>
}