@model CrownTowersClub.ViewModels.MembershipCardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Membership Card";

    // Generate the verification URL
    //var verificationUrl = Url.Action("Verify", "Member", new { id = Model.MembershipNumber }, Request.Url.Scheme);

}

<section class="hero">
    <h1 class="display-lg">My Membership Card</h1>
    <p class="body-lg">Official digital membership card for @Model.ValidYear.</p>
</section>

<div class="flex justify-center membership-card-wrapper">

    <!-- The Premium Card -->
    <div class="membership-card-v2">

        <!-- Top Section: Logo & Status -->
        <div class="card-v2-top">
            <div class="logo-area">
                <img src="@Url.Content("~/Content/app/images/krctk-logo.png")" alt="Club Logo" class="card-logo" />
                <div class="club-name">CROWN TOWERS CLUB</div>
            </div>
            <div class="status-badge">ACTIVE MEMBER</div>
        </div>

        <!-- Middle Section: Name & QR Code -->
        <div class="card-v2-middle">

            <!-- Left: Member Info -->
            <div class="member-info">
                <div class="member-name">@Model.Name</div>
                <div class="member-nric">NRIC: @Model.NRIC</div>
                <div class="member-dept">@Model.Department</div>
                <div class="member-company">@Model.CompanyName</div>
            </div>

            <!-- Right: QR Code -->
            <div class="qr-container">
                <div id="qrcode"></div>
            </div>
        </div>

        <!-- Bottom Section: Details -->
        <div class="card-v2-bottom">
            <div class="detail-group">
                <div class="label">MEMBER NO.</div>
                <div class="value">@Model.MembershipNumber</div>
            </div>
            <div class="detail-group">
                <div class="label">MEMBER SINCE</div>
                <div class="value">@(Model.AdmissionDate.HasValue ? Model.AdmissionDate.Value.ToString("MM/yyyy") : "N/A")</div>
            </div>
            <div class="detail-group">
                <div class="label">VALID UNTIL</div>
                <div class="value">31/12/@Model.ValidYear</div>
            </div>
        </div>
    </div>
</div>

<div class="flex justify-center gap-4 membership-card-actions">
    <button type="button" onclick="window.print();" class="btn btn--primary">
        <span class="material-symbols-outlined membership-card-print-icon">print</span>
        Print Card
    </button>
    @*<a href="@Url.Action("Card", "Member")" class="btn btn--outline">Switch to Classic Design</a>*@
    <a href="@Url.Action("Mine", "Member")" class="btn btn--outline">Back to My Applications</a>
</div>

@section scripts {
    <!-- QR Code Library -->
    <script src="@Url.Content("~/Scripts/vendor/qrcode/qrcode.min.js")"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Generate the QR Code
            @*var qrData = "@verificationUrl";*@
            var qrData = "@Model.MembershipNumber";
            new QRCode(document.getElementById("qrcode"), {
                text: qrData,
                width: 256,
                height: 256,
                colorDark : "#000000",
                colorLight : "#ffffff",
                correctLevel : QRCode.CorrectLevel.H // High error correction
            });
        });
    </script>
}