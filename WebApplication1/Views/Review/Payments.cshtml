@model IReadOnlyList<CrownTowersClub.ViewModels.PendingPaymentViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Pending Payments";
}

<section class="hero">
    <h1 class="display-lg">Pending Payments</h1>
    <p class="body-lg">
        Record initial admission fees for newly approved members.
    </p>
</section>

<section class="card">
    @if (Model == null || Model.Count == 0)
    {
        <p class="body-md">There are currently no pending payments.</p>
    }
    else
    {
        <table class="queue-table">
            <thead>
                <tr>
                    <th>Mbr. Number</th>
                    <th>Applicant</th>
                    <th>Year</th>
                    <th>Amount</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td><strong>@m.MembershipNumber</strong></td>
                        <td>
                            @m.Name<br />
                            <span class="label-sm" style="color: var(--on-surface-variant);">@m.NRIC</span>
                        </td>
                        <td>@m.MembershipYear</td>
                        <td>@m.FeeAmount.ToString("C", System.Globalization.CultureInfo.CreateSpecificCulture("ms-MY"))</td>
                        <td class="queue-table__action">
                            <!-- Pass data via data-attributes to the JS -->
                            <button class="btn btn--primary btn-record-payment"
                                    type="button"
                                    data-term-id="@m.MembershipTermId"
                                    data-amount="@m.FeeAmount"
                                    data-name="@m.Name">
                                Record Payment
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<script>
    window.CTClubPayments = {
        processUrl: "@Url.Action("ProcessPayment", "Review")"
    };
</script>

@section scripts {
    @Scripts.Render("~/bundles/app-base")
    <script src="@Url.Content("~/Scripts/app/payments.js")"></script>
}