@model IReadOnlyList<CrownTowersClub.Models.Member>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Pending Reviews";
}

<section class="hero">
    <h1 class="display-lg">Pending Reviews</h1>
    <p class="body-lg">
        New applications from your department, awaiting your verification.
    </p>
</section>

<section class="card">
    @if (Model == null || Model.Count == 0)
    {
        <p class="body-md">No pending applications.</p>
    }
    else
    {
        <table class="queue-table">
            <thead>
                <tr>
                    <th>Applicant</th>
                    <th>NRIC</th>
                    <th>Submitted</th>
                    <th>Status</th>
                    <th class="queue-table__action">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.Name</td>
                        <td>@m.NRIC</td>
                        <td>@(m.ApplicationDate.ToString("yyyy-MM-dd"))</td>
                        <td>
                            <span class="status-pill status-pill--pending">
                                @m.ApplicationStatus
                            </span>
                        </td>
                        <td class="queue-table__action">
                            @Html.ActionLink(
                                "Review",
                                "Detail",
                                "Review",
                                new { id = m.MemberId },
                                new { @class = "btn btn--primary" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>